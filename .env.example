# Public (safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Production: https://tonaura.com (www and legacy .io already 301 to apex)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: set true only when Apple provider is ready; production CTA stays hidden by default
# NEXT_PUBLIC_ENABLE_APPLE_AUTH=true
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_LINK_MONTHLY=https://buy.stripe.com/00w5kCfwhfzidqwag42kw02
NEXT_PUBLIC_STRIPE_LINK_YEARLY=https://buy.stripe.com/cNi28qck50Eo1HO87W2kw03
NEXT_PUBLIC_STRIPE_LINK_LIFETIME=https://buy.stripe.com/dRmdR82Jvbj286cfAo2kw01

# Server only — never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_PRICE_LIFETIME=

# Optional bootstrap: comma-separated emails treated as admin until you set profiles.role
ADMIN_EMAILS=

# Fastmail SMTP (transactional: welcome, payment, contact, waitlist)
SMTP_HOST=smtp.fastmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@tonaura.io
SMTP_PASS=
MAIL_FROM_SUPPORT=support@tonaura.io
MAIL_FROM_INFO=info@tonaura.io
MAIL_FROM_BILLING=billing@tonaura.io
MAIL_SUPPORT_INBOX=support@tonaura.io
